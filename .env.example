# Server Configuration
PORT=3000

# --- Refresh cadence (see README "Refresh timing" section for details) ---

# How often to ICMP-ping every printer and update Online/Offline status.
# Cheap and safe to run frequently. Default: 60000 ms = 60 seconds.
PING_INTERVAL_MS=60000

# How often to run a full SNMP read (toner levels + maintenance kit life)
# for every online printer. This is the heavier operation, so it's kept
# less frequent than the ping check by default. Default: 900000 ms = 15 minutes.
# Model, Serial Number, and Location are read once at server startup only
# and are NOT part of this recurring job.
SNMP_REFRESH_INTERVAL_MS=900000

# SNMP Configuration
SNMP_COMMUNITY=public
SNMP_TIMEOUT=2000
SNMP_RETRIES=1

# Ping Configuration
PING_TIMEOUT=2

# Excel File Paths (relative to project root)
SURVEY_FILE=./config/Survey.xlsx
SNMP_FILE=./config/SNMP.xlsx
